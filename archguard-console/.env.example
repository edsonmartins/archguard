# ArchGuard Console — Environment Variables
#
# Copy to .env (which is gitignored) and fill in the values below.
# Never commit a populated .env to the repo.

# ── ArchGuard SaaS (Casdoor fork) ─────────────────────────────────────────
ARCHGUARD_ID_URL=https://app.archguard.com.br
VITE_ARCHGUARD_ID_URL=https://app.archguard.com.br
ARCHGUARD_SA_CLIENT_ID=replace-with-client-id
ARCHGUARD_SA_CLIENT_SECRET=replace-with-client-secret

# Optional audit outbox forwarder. Events remain durable locally when unset.
AUDIT_OUTBOX_FORWARDER_URL=
AUDIT_OUTBOX_FORWARDER_TOKEN=

# Optional RustGuac session broker (disabled unless explicitly enabled).
# Keep the API URL private; PUBLIC_URL is the browser-reachable HTTPS origin.
RUSTGUAC_ENABLED=0
RUSTGUAC_URL=http://rustguac:8080
RUSTGUAC_PUBLIC_URL=https://rustguac.archgate.com.br
RUSTGUAC_API_KEY=replace-with-poweruser-api-key

# ── Session encryption ───────────────────────────────────────────────────
# 32-byte hex string (64 chars). Generate with:
#   openssl rand -hex 32
# Rotating this invalidates all active sessions.
SESSION_SECRET=
